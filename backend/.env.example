# Django Settings
SECRET_KEY=django-insecure-resqpath-supersecret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL required by spec, falls back cleanly to SQLite if MySQL is not initialized)
DB_ENGINE=django.db.backends.mysql
DB_NAME=resqpath_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# SMS / OTP Provider (Twilio / Msg91 / Fast2SMS)
# If empty, development testing mode is automatically used with honest UI label
SMS_PROVIDER=DEV_MODE
SMS_API_KEY=
SMS_SENDER_ID=

# AI Chatbot API (Google Gemini / OpenAI)
# If empty, clinical decision-tree fallback mode is used with honest UI label
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Maps Platform
# If empty, interactive Leaflet/OpenStreetMap fallback is clearly disclosed
GOOGLE_MAPS_API_KEY=
